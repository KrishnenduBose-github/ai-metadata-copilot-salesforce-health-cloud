<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores one deployment comparison and risk assessment run.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Deployment Assessment</label>
    <nameField>
        <displayFormat>DA-{00000}</displayFormat>
        <label>Deployment Assessment Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Deployment Assessments</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
