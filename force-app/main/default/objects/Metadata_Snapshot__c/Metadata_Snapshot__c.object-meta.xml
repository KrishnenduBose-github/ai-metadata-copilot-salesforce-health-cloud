<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores one metadata extraction or environment comparison snapshot.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Metadata Snapshot</label>
    <nameField>
        <displayFormat>MS-{00000}</displayFormat>
        <label>Metadata Snapshot Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Metadata Snapshots</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
